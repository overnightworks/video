{
  "name": "overnightworks-video-browser",
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@12.21.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24 || ^26",
      "onFail": "error"
    }
  },
  "scripts": {
    "prepack": "pnpm run build",
    "check": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "monocart-coverage-reports": "^3.2.1",
    "typescript": "^7.0.2"
  }
}
